# Copy to .env and fill in. Never commit .env.

# Public URL Ghost generates links for. Local: http://localhost:2368 · Production: https://laser.xpektrum.com
GHOST_URL=http://localhost:2368
# Host interface/port for Ghost. Keep 127.0.0.1 in production (Caddy proxies to it).
GHOST_BIND=127.0.0.1
GHOST_PORT=2368

# MySQL 8.0 – generate with: openssl rand -base64 24
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=ghost
MYSQL_USER=ghost
MYSQL_PASSWORD=change-me-ghost

# Mail (SMTP) – placeholders. Needed for staff invites, password resets and device verification.
MAIL_FROM=noreply@xpektrum.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Set to true once SMTP works (new-device email codes for staff logins).
STAFF_DEVICE_VERIFICATION=false

# Staff account created by scripts/bootstrap.sh (owner).
GHOST_ADMIN_NAME="Xpektrum Admin"
GHOST_ADMIN_EMAIL=admin@example.com
# At least 10 characters, not trivially guessable.
GHOST_ADMIN_PASSWORD=change-me-to-a-long-passphrase
GHOST_SITE_TITLE="Xpektrum Agency"

# Theme settings applied by bootstrap (Design → Site-wide). Leave empty to keep defaults.
QUOTE_FORM_ENDPOINT=
LINKEDIN_URL=
INSTAGRAM_URL=

# Production profile (Caddy + Let's Encrypt)
DOMAIN=laser.xpektrum.com
ACME_EMAIL=info@xpektrum.com
