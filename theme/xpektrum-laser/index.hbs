{{!< default}}
{{!-- Collection listing (/projects/). --}}
<section class="bg-background text-foreground py-24 md:py-32 px-4 md:px-8">
    <div class="max-w-7xl mx-auto">
        <div class="mb-16 md:mb-24 max-w-2xl">
            <h1 class="text-4xl md:text-6xl font-default font-bold tracking-tighter mb-6 uppercase">Projects</h1>
            <p class="text-lg md:text-xl text-muted-foreground font-default leading-relaxed">Precision laser engraving and cutting solutions for Montreal's leading agencies and industrial partners.</p>
        </div>
        <div class="xp-projects grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
            {{#foreach posts}}
                {{> project-card}}
            {{/foreach}}
        </div>
        {{pagination}}
    </div>
</section>
