{{!< default}}
{{!-- Project detail page (/projects/{slug}/). --}}
{{#post}}
<article class="{{post_class}} py-24 md:py-32">
    <header class="container mx-auto px-4 md:px-6 max-w-5xl mb-12">
        <a href="/#recent-commercial-projects" class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-widest text-muted-foreground hover:text-primary mb-8">{{> icons/arrow-left class="w-4 h-4"}} Recent Projects</a>
        {{#if custom_excerpt}}<p class="text-primary font-mono text-xs md:text-sm uppercase tracking-widest mb-4">{{custom_excerpt}}</p>{{/if}}
        <h1 class="text-4xl md:text-6xl font-default font-bold tracking-tighter uppercase">{{title}}</h1>
    </header>
    {{#if feature_image}}
        <figure class="container mx-auto px-4 md:px-6 max-w-5xl mb-12">
            <picture>
                <source type="image/avif" sizes="(min-width: 1140px) 1024px, 100vw" srcset="{{img_url feature_image size="m" format="avif"}} 750w, {{img_url feature_image size="l" format="avif"}} 1140w, {{img_url feature_image size="xl" format="avif"}} 1600w">
                <img class="w-full h-auto border border-border/10" sizes="(min-width: 1140px) 1024px, 100vw"
                    srcset="{{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 1140w, {{img_url feature_image size="xl"}} 1600w"
                    src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" fetchpriority="high">
            </picture>
            {{#if feature_image_caption}}<figcaption class="mt-3 text-sm text-muted-foreground">{{feature_image_caption}}</figcaption>{{/if}}
        </figure>
    {{/if}}
    <div class="gh-content text-lg">
        {{content}}
    </div>
    <div class="container mx-auto px-4 md:px-6 max-w-3xl mt-16">
        <a href="/request-a-quote/" class="xp-btn group inline-flex items-center justify-center gap-2 h-14 px-8 rounded-none bg-primary text-primary-foreground font-default font-bold uppercase tracking-wider hover:bg-primary/90 hover:shadow-[0_0_20px_rgba(0,242,255,0.4)] transition-all">Start a similar project {{> icons/arrow-right class="w-5 h-5 transition-transform group-hover:translate-x-1"}}</a>
    </div>
</article>

<section class="border-t border-border py-24" aria-labelledby="xp-more-projects">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
        <h2 id="xp-more-projects" class="text-3xl md:text-5xl font-default font-bold tracking-tighter uppercase mb-12">More Projects</h2>
        <div class="xp-projects grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6">
            {{#get "posts" filter="tag:project+id:-{{id}}" limit="2"}}
                {{#foreach posts}}{{> project-card}}{{/foreach}}
            {{/get}}
        </div>
    </div>
</section>
{{/post}}
