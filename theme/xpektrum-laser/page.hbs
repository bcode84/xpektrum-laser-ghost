{{!< default}}
{{!-- Generic page: title + Ghost editor content. Migrated pages use custom-full-width / custom-sector / custom-quote. --}}
{{#page}}
<article class="{{post_class}} py-24 md:py-32">
    {{#if @page.show_title_and_feature_image}}
    <header class="container mx-auto px-4 md:px-6 max-w-3xl mb-12">
        <h1 class="text-4xl md:text-6xl font-default font-bold tracking-tighter uppercase">{{title}}</h1>
        {{#if custom_excerpt}}<p class="mt-6 text-lg md:text-xl text-muted-foreground leading-relaxed">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if feature_image}}
        <figure class="container mx-auto px-4 md:px-6 max-w-5xl mb-12">
            <img class="w-full h-auto" srcset="{{img_url feature_image size="m"}} 750w, {{img_url feature_image size="l"}} 1140w, {{img_url feature_image size="xl"}} 1600w" sizes="(min-width: 1140px) 1024px, 100vw" src="{{img_url feature_image size="l"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </figure>
    {{/if}}
    {{/if}}
    <div class="gh-content">
        {{content}}
    </div>
</article>
{{/page}}
