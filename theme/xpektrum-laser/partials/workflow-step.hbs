<li class="xp-step min-w-0 shrink-0 grow-0 basis-full pl-4 md:basis-1/3 lg:basis-1/5 relative z-10"{{#if @first}} data-active{{/if}}>
    <div class="xp-step-inner flex flex-col items-center text-center px-4 transition-all duration-500">
        <div class="xp-step-tile w-24 h-24 rounded-none flex items-center justify-center mb-6 transition-all duration-500 relative bg-card border">
            {{#match @number 1}}{{> icons/file-text class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            {{#match @number 2}}{{> icons/message-circle class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            {{#match @number 3}}{{> icons/send class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            {{#match @number 4}}{{> icons/map class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            {{#match @number 5}}{{> icons/circle-check class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            {{#match @number ">" 5}}{{> icons/circle-check class="w-8 h-8 transition-transform duration-500"}}{{/match}}
            <div class="xp-step-num absolute -top-3 -right-3 w-10 h-10 rounded-none flex items-center justify-center text-xs font-mono font-bold transition-colors duration-500">{{#match @number "<" 10}}0{{/match}}{{@number}}</div>
        </div>
        <h3 class="xp-step-title text-xl font-default font-bold mb-3 transition-colors duration-300 uppercase tracking-tight">{{title}}</h3>
        <p class="text-sm text-muted-foreground font-default leading-relaxed">{{custom_excerpt}}</p>
    </div>
</li>
