{{!-- Overrides Ghost's {{navigation}} output. "Services" becomes a dropdown of the #sector pages. --}}
<ul class="flex flex-1 list-none items-center justify-center gap-8">
    {{#foreach navigation}}
        {{#match label "Services"}}
            <li class="relative xp-dropdown">
                <button type="button" class="xp-dropdown-toggle group inline-flex items-center py-2 relative text-xs font-default font-bold uppercase tracking-widest text-foreground transition-colors hover:text-primary" aria-expanded="false" aria-controls="xp-services-menu">
                    {{label}}
                    <span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span>
                    {{> icons/chevron-down class="relative top-[1px] ml-1 size-3 transition duration-300 xp-chevron"}}
                </button>
                <div id="xp-services-menu" class="xp-dropdown-menu absolute left-1/2 top-full mt-4 -translate-x-1/2 w-64 border border-border bg-popover shadow-lg" hidden>
                    <ul class="py-2">
                        {{#get "pages" filter="tag:hash-sector" order="published_at asc" limit="20"}}
                            {{#foreach pages}}
                                <li><a href="{{url}}" class="block px-4 py-2 text-xs font-default font-bold uppercase tracking-widest text-foreground hover:bg-accent hover:text-primary transition-colors">{{title}}</a></li>
                            {{/foreach}}
                        {{/get}}
                    </ul>
                </div>
            </li>
        {{else}}
            <li class="relative">
                <a href="{{url absolute="true"}}" class="relative group py-2 p-2 rounded-sm text-xs font-default font-bold uppercase tracking-widest text-foreground transition-colors hover:text-primary hover:bg-accent{{#if current}} text-primary{{/if}}"{{#if current}} aria-current="page"{{/if}}>{{label}}<span class="absolute -bottom-1 left-0 w-0 h-0.5 bg-primary transition-all duration-300 group-hover:w-full"></span></a>
            </li>
        {{/match}}
    {{/foreach}}
</ul>
