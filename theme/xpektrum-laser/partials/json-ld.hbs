{{!-- LocalBusiness structured data on every page (Ghost adds WebSite/Article/WebPage schema itself). --}}
<script type="application/ld+json">
{
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "@id": "{{@site.url}}/#business",
    "name": "{{@site.title}}",
    "description": "{{@site.description}}",
    "url": "{{@site.url}}",
    {{#if @site.logo}}"logo": "{{img_url @site.logo absolute="true"}}",
    "image": "{{img_url @site.logo absolute="true"}}",{{/if}}
    "telephone": "{{@custom.phone}}",
    "email": "{{@custom.email}}",
    "address": {
        "@type": "PostalAddress",
        "addressLocality": "Montreal",
        "addressRegion": "QC",
        "postalCode": "H4V 2A2",
        "addressCountry": "CA"
    },
    "areaServed": "Montreal, QC",
    "openingHoursSpecification": [
        { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], "opens": "08:00", "closes": "18:00" },
        { "@type": "OpeningHoursSpecification", "dayOfWeek": "Saturday", "opens": "10:00", "closes": "15:00" }
    ]{{#if @custom.linkedin_url}},
    "sameAs": ["{{@custom.linkedin_url}}"{{#if @custom.instagram_url}}, "{{@custom.instagram_url}}"{{/if}}]{{else}}{{#if @custom.instagram_url}},
    "sameAs": ["{{@custom.instagram_url}}"]{{/if}}{{/if}}
}
</script>
