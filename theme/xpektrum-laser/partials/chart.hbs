{{!--
    "Production Efficiency Metrics" – inline SVG rebuild of the live Recharts area chart (same geometry and values).
    Xpektrum Precision: 100, 99, 100, 98, 99, 100 · Standard Engraving: 95, 82, 70, 58, 45, 35 (Jan–Jun, %).
    Plot area x 40–582, y 10–280 (100% → 0%). Paths are the monotone curves Recharts produced for these values.
--}}
<figure class="xp-chart w-full" aria-labelledby="xp-chart-title">
    <svg class="w-full h-auto overflow-visible" viewBox="0 0 592 310" role="img" aria-labelledby="xp-chart-title xp-chart-desc">
        <desc id="xp-chart-desc">Area chart, January to June. Xpektrum Precision stays between 98% and 100%. Standard Engraving falls from 95% to 35%.</desc>
        <defs>
            <linearGradient id="xp-fill-primary" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stop-color="var(--primary)" stop-opacity="0.3"/>
                <stop offset="95%" stop-color="var(--primary)" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="xp-fill-muted" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stop-color="var(--muted-foreground)" stop-opacity="0.1"/>
                <stop offset="95%" stop-color="var(--muted-foreground)" stop-opacity="0"/>
            </linearGradient>
        </defs>
        <g stroke="var(--border)" stroke-dasharray="3 3" fill="none">
            <line x1="40" y1="280" x2="582" y2="280"/>
            <line x1="40" y1="212.5" x2="582" y2="212.5"/>
            <line x1="40" y1="145" x2="582" y2="145"/>
            <line x1="40" y1="77.5" x2="582" y2="77.5"/>
            <line x1="40" y1="10" x2="582" y2="10"/>
        </g>
        <g class="xp-chart-ticks" fill="var(--muted-foreground)" font-size="10">
            <text x="22" y="283" text-anchor="end">0%</text>
            <text x="22" y="215.5" text-anchor="end">25%</text>
            <text x="22" y="148" text-anchor="end">50%</text>
            <text x="22" y="80.5" text-anchor="end">75%</text>
            <text x="22" y="13" text-anchor="end">100%</text>
            <text x="40" y="302" text-anchor="middle">JAN</text>
            <text x="148.4" y="302" text-anchor="middle">FEB</text>
            <text x="256.8" y="302" text-anchor="middle">MAR</text>
            <text x="365.2" y="302" text-anchor="middle">APR</text>
            <text x="473.6" y="302" text-anchor="middle">MAY</text>
            <text x="582" y="302" text-anchor="middle">JUN</text>
        </g>
        <path fill="url(#xp-fill-primary)" d="M40,10C76.133,11.35,112.267,12.7,148.4,12.7C184.533,12.7,220.667,10,256.8,10C292.933,10,329.067,15.4,365.2,15.4C401.333,15.4,437.467,13.6,473.6,12.7C509.733,11.8,545.867,10.9,582,10L582,280L40,280Z"/>
        <path fill="url(#xp-fill-muted)" d="M40,23.5C76.133,35.425,112.267,47.35,148.4,58.6C184.533,69.85,220.667,80.2,256.8,91C292.933,101.8,329.067,112.15,365.2,123.4C401.333,134.65,437.467,148.15,473.6,158.5C509.733,168.85,545.867,177.175,582,185.5L582,280L40,280Z"/>
        <path class="xp-chart-line" pathLength="1" fill="none" stroke="var(--muted-foreground)" stroke-width="1" stroke-dasharray="4 4" d="M40,23.5C76.133,35.425,112.267,47.35,148.4,58.6C184.533,69.85,220.667,80.2,256.8,91C292.933,101.8,329.067,112.15,365.2,123.4C401.333,134.65,437.467,148.15,473.6,158.5C509.733,168.85,545.867,177.175,582,185.5"/>
        <path class="xp-chart-line xp-chart-line--primary" pathLength="1" fill="none" stroke="var(--primary)" stroke-width="2" d="M40,10C76.133,11.35,112.267,12.7,148.4,12.7C184.533,12.7,220.667,10,256.8,10C292.933,10,329.067,15.4,365.2,15.4C401.333,15.4,437.467,13.6,473.6,12.7C509.733,11.8,545.867,10.9,582,10"/>
    </svg>
    <figcaption class="flex items-center justify-center gap-4 pt-6 font-mono text-xs">
        <span class="flex items-center gap-1.5">{{> icons/activity class="h-3 w-3 text-muted-foreground"}}Standard Engraving</span>
        <span class="flex items-center gap-1.5">{{> icons/database class="h-3 w-3 text-muted-foreground"}}Xpektrum Precision</span>
    </figcaption>
    <table class="sr-only">
        <caption id="xp-chart-title">Production efficiency, Xpektrum vs. standard consumer-grade lasers (%)</caption>
        <thead><tr><th scope="col">Month</th><th scope="col">Xpektrum Precision</th><th scope="col">Standard Engraving</th></tr></thead>
        <tbody>
            <tr><th scope="row">Jan</th><td>100</td><td>95</td></tr>
            <tr><th scope="row">Feb</th><td>99</td><td>82</td></tr>
            <tr><th scope="row">Mar</th><td>100</td><td>70</td></tr>
            <tr><th scope="row">Apr</th><td>98</td><td>58</td></tr>
            <tr><th scope="row">May</th><td>99</td><td>45</td></tr>
            <tr><th scope="row">Jun</th><td>100</td><td>35</td></tr>
        </tbody>
    </table>
</figure>
