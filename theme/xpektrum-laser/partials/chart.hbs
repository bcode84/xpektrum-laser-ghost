{{!--
    "Production Efficiency Metrics" – inline SVG rebuild of the live Recharts area chart (same geometry and values).
    Xpektrum Precision: 100, 99, 100, 98, 99, 100 · Standard Engraving: 95, 82, 70, 58, 45, 35 (Jan–Jun, %).
    Like Recharts: fixed 350px height, plot area 40px from the left / 10px from the right, 10–280px from the top.
    The SVG stretches horizontally (non-scaling strokes); axis labels are HTML at the same pixel offsets.
--}}
<figure class="xp-chart relative w-full h-[350px] font-mono text-xs" aria-labelledby="xp-chart-title">
    <svg class="xp-chart-plot absolute left-[40px] right-[10px] top-[10px] h-[270px] w-[calc(100%-50px)] overflow-visible" viewBox="40 10 542 270" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <defs>
            <linearGradient id="xp-fill-primary" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stop-color="var(--primary)" stop-opacity="0.3"/>
                <stop offset="95%" stop-color="var(--primary)" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="xp-fill-muted" x1="0" y1="0" x2="0" y2="1">
                <stop offset="5%" stop-color="var(--muted-foreground)" stop-opacity="0.1"/>
                <stop offset="95%" stop-color="var(--muted-foreground)" stop-opacity="0"/>
            </linearGradient>
        </defs>
        <g stroke="var(--border)" stroke-dasharray="3 3" fill="none" vector-effect="non-scaling-stroke">
            <line x1="40" y1="280" x2="582" y2="280" vector-effect="non-scaling-stroke"/>
            <line x1="40" y1="212.5" x2="582" y2="212.5" vector-effect="non-scaling-stroke"/>
            <line x1="40" y1="145" x2="582" y2="145" vector-effect="non-scaling-stroke"/>
            <line x1="40" y1="77.5" x2="582" y2="77.5" vector-effect="non-scaling-stroke"/>
            <line x1="40" y1="10" x2="582" y2="10" vector-effect="non-scaling-stroke"/>
        </g>
        <g class="xp-chart-series">
            <path fill="url(#xp-fill-primary)" d="M40,10C76.133,11.35,112.267,12.7,148.4,12.7C184.533,12.7,220.667,10,256.8,10C292.933,10,329.067,15.4,365.2,15.4C401.333,15.4,437.467,13.6,473.6,12.7C509.733,11.8,545.867,10.9,582,10L582,280L40,280Z"/>
            <path fill="url(#xp-fill-muted)" d="M40,23.5C76.133,35.425,112.267,47.35,148.4,58.6C184.533,69.85,220.667,80.2,256.8,91C292.933,101.8,329.067,112.15,365.2,123.4C401.333,134.65,437.467,148.15,473.6,158.5C509.733,168.85,545.867,177.175,582,185.5L582,280L40,280Z"/>
            <path fill="none" stroke="var(--muted-foreground)" stroke-width="1" stroke-dasharray="4 4" vector-effect="non-scaling-stroke" d="M40,23.5C76.133,35.425,112.267,47.35,148.4,58.6C184.533,69.85,220.667,80.2,256.8,91C292.933,101.8,329.067,112.15,365.2,123.4C401.333,134.65,437.467,148.15,473.6,158.5C509.733,168.85,545.867,177.175,582,185.5"/>
            <path fill="none" stroke="var(--primary)" stroke-width="2" vector-effect="non-scaling-stroke" d="M40,10C76.133,11.35,112.267,12.7,148.4,12.7C184.533,12.7,220.667,10,256.8,10C292.933,10,329.067,15.4,365.2,15.4C401.333,15.4,437.467,13.6,473.6,12.7C509.733,11.8,545.867,10.9,582,10"/>
        </g>
    </svg>
    <div class="xp-chart-y text-muted-foreground" aria-hidden="true">
        <span style="top:280px">0%</span><span style="top:212.5px">25%</span><span style="top:145px">50%</span><span style="top:77.5px">75%</span><span style="top:10px">100%</span>
    </div>
    <div class="xp-chart-x text-muted-foreground" aria-hidden="true">
        <span style="--i:0">JAN</span><span style="--i:1">FEB</span><span style="--i:2">MAR</span><span style="--i:3">APR</span><span style="--i:4">MAY</span><span style="--i:5">JUN</span>
    </div>
    <figcaption class="absolute bottom-0 -left-5 right-0 flex items-center justify-center gap-4 pt-6">
        <span class="flex items-center gap-1.5">{{> icons/activity class="h-3 w-3 text-muted-foreground"}}Standard Engraving</span>
        <span class="flex items-center gap-1.5">{{> icons/database class="h-3 w-3 text-muted-foreground"}}Xpektrum Precision</span>
    </figcaption>
    <table class="sr-only">
        <caption id="xp-chart-title">Production efficiency, Xpektrum vs. standard consumer-grade lasers (%)</caption>
        <thead><tr><th scope="col">Month</th><th scope="col">Xpektrum Precision</th><th scope="col">Standard Engraving</th></tr></thead>
        <tbody>
            <tr><th scope="row">Jan</th><td>100</td><td>95</td></tr>
            <tr><th scope="row">Feb</th><td>99</td><td>82</td></tr>
            <tr><th scope="row">Mar</th><td>100</td><td>70</td></tr>
            <tr><th scope="row">Apr</th><td>98</td><td>58</td></tr>
            <tr><th scope="row">May</th><td>99</td><td>45</td></tr>
            <tr><th scope="row">Jun</th><td>100</td><td>35</td></tr>
        </tbody>
    </table>
</figure>
